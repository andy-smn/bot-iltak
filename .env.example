# Token du bot (portail développeur Discord > Bot > Reset Token)
DISCORD_TOKEN=

# Identifiant de l'application (portail développeur Discord > General Information > Application ID)
CLIENT_ID=

# Identifiant Discord du propriétaire du bot. Il est toujours MJ et seul à pouvoir
# utiliser /set-mj, /remove-mj et /liste-mj (utile sur un hébergeur sans console).
# Clic droit sur votre profil Discord > Copier l'identifiant (mode développeur activé).
OWNER_ID=

# Optionnel : dossier des fichiers JSON (par défaut : ./data)
# DATA_DIR=
